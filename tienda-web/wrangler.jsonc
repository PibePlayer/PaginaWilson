{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "tienda-web",
  "main": ".open-next/worker.js",

  "compatibility_date": "2026-09-01",

  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  "placement": {
    "mode": "smart"
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "kv_namespaces": [
    {
      "binding": "CATALOG_CACHE",
      "id": "d26c2f5c095b4cf0a2e201a97220386e"
    }
  ],

  "routes": [
    {
      "pattern": "sogue.com.ar",
      "custom_domain": true
    }
  ],

  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },

  "workers_dev": true,
  "preview_urls": true,

  "env": {
    "clickspro": {
      "name": "tienda-web-clickspro",

      "kv_namespaces": [
        {
          "binding": "CATALOG_CACHE",
          "id": "4daf17a088b94e4d996c95364f96a9aa"
        }
      ],

      "routes": []
    }
  }
}